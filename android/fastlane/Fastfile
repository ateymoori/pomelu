# Pomelu Google Play lanes; run from android/ (`cd android && fastlane <lane>`).
# Auth: the service account key in Appfile. Signing: android/key.properties.
default_platform(:android)

ROOT = File.expand_path('../..')
AAB = "#{ROOT}/build/app/outputs/bundle/release/app-release.aab"

platform :android do
  desc 'Release AAB; keep build/symbols for crash stacks'
  lane :build do
    # Gradle builds without them (debug signing, no push): never a store build.
    %w[key.properties firebase.properties].each do |f|
      UI.user_error!("android/#{f} is missing") unless File.exist?("#{ROOT}/android/#{f}")
    end
    Dir.chdir(ROOT) do
      sh('flutter', 'build', 'appbundle', '--release', '--obfuscate',
         '--split-debug-info=build/symbols')
    end
  end

  # Rolled out to the testers at once (the app is published, so Play takes
  # any release status).
  desc 'Build and upload to the closed test (bump the build number in pubspec first)'
  lane :beta do
    build
    upload_to_play_store(
      track: 'alpha',
      aab: AAB,
      release_status: 'completed',
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc 'Send the Alpha build of this pubspec version to production, full rollout'
  lane :production do
    code = File.read("#{ROOT}/pubspec.yaml")[/^version: .*\+(\d+)/, 1]
    upload_to_play_store(
      track: 'alpha',
      track_promote_to: 'production',
      track_promote_release_status: 'completed',
      version_code: code,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc 'Push store text, icon, feature graphic and screenshots'
  lane :metadata do
    upload_to_play_store(
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
    )
  end
end
